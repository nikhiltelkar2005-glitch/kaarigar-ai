# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kaarigar_ai?schema=public"

# ─── JWT Secrets ──────────────────────────────────────────────────────────────
# Generate secure random strings: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="replace_with_64_char_random_string"
JWT_REFRESH_SECRET="replace_with_another_64_char_random_string"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ─── CORS ─────────────────────────────────────────────────────────────────────
CLIENT_ORIGIN="*"

# ─── AI Studio ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

