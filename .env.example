# ========================================================
# Kaarigar AI - Root Environment Reference
# ========================================================
# For Backend configuration, copy backend/.env.example to backend/.env
# For Mobile configuration, copy mobile/.env.example to mobile/.env
# ========================================================

# BACKEND
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kaarigar_dev?schema=public
JWT_ACCESS_SECRET=your_jwt_access_secret_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=*

# MOBILE (EXPO)
EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1

